	"components": {
		"schemas": {
			"AttendanceService": {
				"properties": {
					"name": {
						"type": "string",
						"title": "Name"
					},
					"email": {
						"type": "string",
						"format": "email",
						"title": "Email"
					},
					"contact_number": {
						"type": "string",
						"title": "Contact Number"
					},
					"doc_id": {
						"type": "string",
						"title": "Doc Id"
					},
					"waitlist": {
						"anyOf": [
							{
								"type": "boolean"
							},
							{
								"type": "null"
							}
						],
						"title": "Waitlist",
						"default": false
					},
					"event_assistance_id": {
						"type": "integer",
						"title": "Event Assistance Id"
					}
				},
				"type": "object",
				"required": [
					"name",
					"email",
					"contact_number",
					"doc_id",
					"event_assistance_id"
				],
				"title": "AttendanceService",
				"description": "Handles all the crud operations and \nservices needed for an attendance."
			},
			"ConfirmationRes": {
				"properties": {
					"name": {
						"type": "string",
						"title": "Name"
					},
					"email": {
						"type": "string",
						"format": "email",
						"title": "Email"
					},
					"contact_number": {
						"type": "string",
						"title": "Contact Number"
					},
					"doc_id": {
						"type": "string",
						"title": "Doc Id"
					},
					"waitlist": {
						"anyOf": [
							{
								"type": "boolean"
							},
							{
								"type": "null"
							}
						],
						"title": "Waitlist",
						"default": false
					},
					"event_assistance_id": {
						"type": "integer",
						"title": "Event Assistance Id"
					}
				},
				"type": "object",
				"required": [
					"name",
					"email",
					"contact_number",
					"doc_id",
					"event_assistance_id"
				],
				"title": "ConfirmationRes",
				"description": "Confirmation and update success response"
			},
			"HTTPValidationError": {
				"properties": {
					"detail": {
						"items": {
							"$ref": "#/components/schemas/ValidationError"
						},
						"type": "array",
						"title": "Detail"
					}
				},
				"type": "object",
				"title": "HTTPValidationError"
			},
			"ValidationError": {
				"properties": {
					"loc": {
						"items": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "integer"
								}
							]
						},
						"type": "array",
						"title": "Location"
					},
					"msg": {
						"type": "string",
						"title": "Message"
					},
					"type": {
						"type": "string",
						"title": "Error Type"
					}
				},
				"type": "object",
				"required": [
					"loc",
					"msg",
					"type"
				],
				"title": "ValidationError"
			}
		}
